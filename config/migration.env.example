# Copy these entries into a private local/CI environment only after staging
# resources have been created. This file contains placeholders, never secrets.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=animesparks_staging

R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<staging-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<staging-r2-secret-access-key>
R2_BUCKET_NAME=animesparks-staging
R2_S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://<staging-assets-domain>
R2_REGION=auto

# Existing production Sanity variables remain in the normal environment.
# BLOG_PUBLISH_KEY is still used by the current publishing integration.
